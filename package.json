{
  "name": "stream-event-client",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --type-aware .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "e2e": "pnpm build && playwright test -c e2e/playwright.config.ts",
    "e2e:record": "pnpm build && playwright test -c e2e/record.config.ts",
    "proof:weeb3": "pnpm build && playwright test -c e2e/weeb3-live.config.ts",
    "test:image": "node --test test/docker/image.docker.mjs",
    "test:docker": "pnpm test:image && PLAYWRIGHT_INSTALL_DEPS=1 pnpm e2e:record"
  },
  "dependencies": {
    "@ethersphere/bee-js": "13.1.0",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/domine": "5.3.0",
    "@fontsource/geist": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@lat-murmeldjur/weeb_3": "0.0.354001",
    "@solarpunkltd/swarm-chat-js": "7.2.0",
    "cafe-utility": "36.3.0",
    "emoji-picker-react": "4.22.2",
    "hls.js": "1.7.3",
    "p-queue": "9.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "swr": "2.5.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "acorn": "8.18.0",
    "jsdom": "30.0.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "sass": "1.104.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
